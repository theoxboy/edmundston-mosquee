    { "re": "^· dans (\\d+) min$", "ar": "· بعد $1 دقيقة", "en": "· in $1 min" },
    { "re": "^dans (\\d+) h (\\d\\d)$", "ar": "بعد $1 س $2 د", "en": "in $1 h $2" },
    { "re": "^dans (\\d+) min$", "ar": "بعد $1 دقيقة", "en": "in $1 min" },
    { "re": "^© (\\d{4}) Edmundston Islamic Centre — Edmundston, Québec$", "ar": "© $1 الجمعية الاجتماعية الثقافية الإسلامية بإدموندستون — إدموندستون، كيبيك", "en": "© $1 Edmundston Islamic Centre — Edmundston, Quebec" },
    { "re": "^(\\d[\\d\\s.,]*) \\$ récoltés · (\\d+(?:[.,]\\d+)?) ?%$", "ar": "$1 $ مجموعة · $2 %", "en": "$1 $ raised · $2 %" }
